@page "/city/listing"
@model WebApp.Pages.CityListing

@{
    ViewData["CityListing"] = "City Listing";
}

<div class="card">
    <div class="card-header">
        Cities
    </div>
    <ul class="list-group">
        @foreach (var city in Model.Cities)
        {
            <li class="list-group-item">
                <a asp-route-cityName="@city" asp-page="/CityDetails">@city</a>
            </li>
        }
    </ul>
</div>

