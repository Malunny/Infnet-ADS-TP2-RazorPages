@page "/city/create"
@model WebApp.Pages.CreateCity

@{
    ViewData["Title"] = "Create City";
}

<div class="card">
    <header class="card-header">
        <h3>City Creator</h3>
    </header>
    <form method="post">
        <div class="d-flex flex-column card-body gap-1">
            <label>
                
            </label>
            <label class="form-label" for="cityName">City Name</label>
            <input id="cityName" 
                class="form-control" type="text" name="CityName"/>

            @if (!string.IsNullOrEmpty(TempData["CityName"]?.ToString()))
            {
                <b class="d-block">The @TempData["CityName"] has been created!</b>
            }
            @if (!string.IsNullOrEmpty(TempData["Error"]?.ToString()))
            {
                <b class="d-block text-danger">@TempData["Error"]</b>
            }
        </div>
        <div class="card-footer">
            <button class="btn btn-primary">Create</button>
        </div>
    </form>
        
</div>